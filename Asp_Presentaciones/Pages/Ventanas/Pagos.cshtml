@page
@model Asp_Presentaciones.Pages.Ventanas.PagosModel
@{
    ViewData["Title"] = "Pagos"; bool admin = Model.EsAdministrador; bool recep = Model.EsRecepcionista;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Pagos</h1>
        <p class="text-tenue mb-0">Registro de los pagos </p>
    </div>
    @if (admin || recep)
    {
        <button class="btn btn-oro" onclick="bbAbrirModal('modalPagos', null)">+ Registrar pago</button>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success py-2">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMsg))
{
    <div class="alert alert-danger  py-2">@Model.ErrorMsg</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    @if (admin)
    {
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
    }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card">
            <div class="bb-card-body p-0">
                <table class="bb-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cita</th>
                            <th>Monto</th>
                            <th>Descuento</th>
                            <th>Total</th>
                            <th>Método</th>
                            <th>Estado</th>
                            <th class="acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Lista.Count == 0)
                        {
                            <tr><td colspan="8" class="text-tenue text-center py-4">Sin pagos registrados.</td></tr>
                        }
                        @foreach (var p in Model.Lista)
                        {
                            var json = Newtonsoft.Json.JsonConvert.SerializeObject(new
                            {
                                p.IdPago,
                                p.IdCita,
                                p.Monto,
                                p.Descuento,
                                p.Total,
                                p.NombreMetodo,
                                p.EstadoPago,
                                p.Observaciones
                            });
                            <tr>
                                <td>@p.IdPago</td>
                                <td><small>@Model.NombreCita(p.IdCita)</small></td>
                                <td>$@p.Monto.ToString("N0")</td>
                                <td>$@p.Descuento.ToString("N0")</td>
                                <td><strong>$@p.Total.ToString("N0")</strong></td>
                                <td>@p.NombreMetodo</td>
                                <td>
                                    <span class="estado @(p.EstadoPago == "Aprobado" ? "activo" : p.EstadoPago == "Rechazado" ? "inactivo" : "")">
                                        @p.EstadoPago
                                    </span>
                                </td>
                                <td class="acciones">
                                    @if ((admin || recep) && p.EstadoPago != "Aprobado")
                                    {
                                        <form method="post" asp-page-handler="Procesar" class="d-inline">
                                            <input type="hidden" name="Item.IdPago" value="@p.IdPago" />
                                            <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-oro-claro)">
                                                 Aprobar
                                            </button>
                                        </form>
                                    }
                                    @if (admin)
                                    {
                                        <button class="btn btn-sm btn-fantasma" data-json="@json"
                                                onclick="bbAbrirModal('modalPagos', JSON.parse(this.dataset.json))">
                                            Editar
                                        </button>
                                        <form method="post" asp-page-handler="Eliminar" class="d-inline"
                                              onsubmit="return bbConfirmarBorrado(event)">
                                            <input type="hidden" name="Item.IdPago" value="@p.IdPago" />
                                            <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">
            <div class="bb-card">
                <div class="bb-card-body p-0">
                    <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Pago"))" />
                </div>
            </div>
        </div>
    }
</div>

@if (admin || recep)
{
    <div class="modal fade" id="modalPagos" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Guardar" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> pago</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Item.IdPago" />

                  
                    <div class="mb-3">
                        <label class="form-label">Cita a pagar</label>
                        <select asp-for="Item.IdCita" class="form-select" required>
                            <option value="">— Seleccione una cita —</option>
                            @foreach (var c in Model.Citas)
                            {
                                <option value="@c.IdCita">
                                    Cita #@c.IdCita — Cliente #@c.IdCliente
                                    — @(c.FechaHoraInicio?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    — @c.Estado
                                </option>
                            }
                        </select>
                    </div>

                    <div class="row">
                        <div class="col mb-3">
                            <label class="form-label">Monto ($)</label>
                            <input asp-for="Item.Monto" type="number" min="0" step="500"
                                   class="form-control" required />
                        </div>
                        <div class="col mb-3">
                            <label class="form-label">Descuento ($)</label>
                            <input asp-for="Item.Descuento" type="number" min="0" step="500"
                                   class="form-control" value="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Método de pago</label>
                        <select asp-for="Item.NombreMetodo" class="form-select" required>
                            <option value="">— Seleccione —</option>
                            @foreach (var m in PagosModel.MetodosPago)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <input asp-for="Item.Observaciones" class="form-control"
                               placeholder="Opcional..." />
                    </div>

                    <div class="alert alert-info py-2 mb-0" style="font-size:0.85rem">
                         Al guardar el pago se <strong>genera la factura automáticamente</strong> con IVA del 19%.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-oro">Registrar pago</button>
                </div>
            </form>
        </div>
    </div>
}