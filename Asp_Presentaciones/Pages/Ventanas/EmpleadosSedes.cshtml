@page
@model Asp_Presentaciones.Pages.Ventanas.EmpleadosPorSedeModel
@{
    ViewData["Title"] = "Empleados por Sede";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Empleados por Sede</h1>
        <p class="text-tenue mb-0">Gestión real de asignaciones</p>
    </div>

    <button class="btn btn-oro" onclick="bbAbrirModal('modalEPS', null)">
        + Agregar
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success py-2">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMsg))
{
    <div class="alert alert-danger py-2">@Model.ErrorMsg</div>
}

<table class="bb-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Empleado</th>
            <th>Sede</th>
            <th>Fecha</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Lista)
        {
            var json = Newtonsoft.Json.JsonConvert.SerializeObject(item);

            <tr>
                <td>@item.IdEmpleadoSede</td>

                <td>@Model.NombreEmpleado(item.IdEmpleado)</td>
                <td>@Model.NombreSede(item.IdSede)</td>
                <td>@item.FechaAsignacion</td>

                <td>
                    <button class="btn btn-sm btn-fantasma"
                            data-json="@json"
                            onclick="bbAbrirModal('modalEPS', JSON.parse(this.dataset.json))">
                        Editar
                    </button>

                    <form method="post" asp-page-handler="Eliminar" class="d-inline">
                        <input type="hidden" name="Item.IdEmpleadoSede" value="@item.IdEmpleadoSede" />
                        <button class="btn btn-sm btn-fantasma" style="color:red">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>


<div class="modal fade" id="modalEPS" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Asignación empleado-sede</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" asp-for="Item.IdEmpleadoSede" />

                <div class="mb-3">
                    <label>Empleado</label>
                    <select asp-for="Item.IdEmpleado" class="form-control">
                        <option value="0">Seleccione</option>
                        @foreach (var e in Model.Empleados)
                        {
                            <option value="@e.IdEmpleado">
                                Empleado #@e.IdEmpleado
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label>Sede</label>
                    <select asp-for="Item.IdSede" class="form-control">
                        <option value="0">Seleccione</option>
                        @foreach (var s in Model.Sedes)
                        {
                            <option value="@s.IdSede">
                                Sede #@s.IdSede
                            </option>
                        }
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-fantasma" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-oro" type="submit">Guardar</button>
            </div>

        </form>
    </div>
</div>