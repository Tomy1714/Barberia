@page
@model Asp_Presentaciones.Pages.Ventanas.ClientesModel
@{ ViewData["Title"] = "Clientes"; bool admin = Model.EsAdministrador; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 style="color:var(--bb-oro-claro);margin:0">Clientes</h1>
    <button class="btn btn-oro" onclick="bbAbrirModal('modalCliente', null)">+ Agregar cliente</button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    @if (admin) { <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li> }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th><th>Persona</th><th>Visitas</th><th>Estado</th><th class="acciones">Acciones</th></tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="5" class="text-tenue text-center py-4">Sin clientes.</td></tr> }
                    @foreach (var c in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { c.IdCliente, c.IdPersona, c.TotalVisitas, c.Activo });
                        <tr>
                            <td>@c.IdCliente</td>
                            <td>@Model.NombrePersona(c.IdPersona) <span class="text-tenue">#@c.IdPersona</span></td>
                            <td>@c.TotalVisitas</td>
                            <td><span class="estado @(c.Activo ? "activo" : "inactivo")">@(c.Activo ? "Activo" : "Inactivo")</span></td>
                            <td class="acciones">
                                <button class="btn btn-sm btn-fantasma" data-json="@json" onclick="bbAbrirModal('modalCliente', JSON.parse(this.dataset.json))">Editar</button>
                                <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                    <input type="hidden" name="Item.IdCliente" value="@c.IdCliente" />
                                    <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">
            <div class="bb-card"><div class="bb-card-body p-0">
                <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Cliente"))" />
            </div></div>
        </div>
    }
</div>

<div class="modal fade" id="modalCliente" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Item.IdCliente" />
                <div class="mb-3">
                    <label class="form-label">Persona</label>
                    <select asp-for="Item.IdPersona" class="form-select" required>
                        <option value="">— Seleccione —</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.IdPersona">@p.Nombres @p.Apellidos (#@p.IdPersona)</option>
                        }
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">Total visitas</label><input asp-for="Item.TotalVisitas" type="number" min="0" class="form-control" /></div>
                <div class="form-check"><input asp-for="Item.Activo" type="checkbox" class="form-check-input" /><label class="form-check-label" for="Item_Activo">Activo</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>
        </form>
    </div>
</div>
