@page
@model Asp_Presentaciones.Pages.Ventanas.SedesModel
@{ ViewData["Title"] = "Sedes"; bool admin = Model.EsAdministrador; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 style="color:var(--bb-oro-claro);margin:0">Sedes</h1>
    @if (admin) { <button class="btn btn-oro" onclick="bbAbrirModal('modalSede', null)">+ Agregar sede</button> }
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    @if (admin) { <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li> }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th><th>Nombre</th><th>Ciudad</th><th>Dirección</th><th>Teléfono</th><th>Cap.</th><th>Estado</th>@if (admin) { <th class="acciones">Acciones</th> }</tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="8" class="text-tenue text-center py-4">Sin sedes.</td></tr> }
                    @foreach (var s in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { s.IdSede, s.Nombre, s.Direccion, s.Ciudad, s.Telefono, s.Correo, s.CapacidadMaxima, s.Activa, FechaApertura = s.FechaApertura?.ToString("yyyy-MM-dd") });
                        <tr>
                            <td>@s.IdSede</td><td>@s.Nombre</td><td>@s.Ciudad</td>
                            <td class="text-tenue">@s.Direccion</td><td>@s.Telefono</td><td>@s.CapacidadMaxima</td>
                            <td><span class="estado @(s.Activa ? "activo" : "inactivo")">@(s.Activa ? "Activa" : "Inactiva")</span></td>
                            @if (admin)
                            {
                                <td class="acciones">
                                    <button class="btn btn-sm btn-fantasma" data-json="@json" onclick="bbAbrirModal('modalSede', JSON.parse(this.dataset.json))">Editar</button>
                                    <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                        <input type="hidden" name="Item.IdSede" value="@s.IdSede" />
                                        <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">
            <div class="bb-card"><div class="bb-card-body p-0">
                <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Sede"))" />
            </div></div>
        </div>
    }
</div>

@if (admin)
{
    <div class="modal fade" id="modalSede" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Guardar" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span class="modo-titulo">Nueva</span> sede</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Item.IdSede" />
                    <div class="mb-3"><label class="form-label">Nombre</label><input asp-for="Item.Nombre" class="form-control" required /></div>
                    <div class="row">
                        <div class="col mb-3"><label class="form-label">Ciudad</label><input asp-for="Item.Ciudad" class="form-control" /></div>
                        <div class="col mb-3"><label class="form-label">Teléfono</label><input asp-for="Item.Telefono" class="form-control" /></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Dirección</label><input asp-for="Item.Direccion" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Correo</label><input asp-for="Item.Correo" type="email" class="form-control" /></div>
                    <div class="row">
                        <div class="col mb-3"><label class="form-label">Capacidad máxima</label><input asp-for="Item.CapacidadMaxima" type="number" min="0" class="form-control" /></div>
                        <div class="col mb-3"><label class="form-label">Fecha apertura</label><input asp-for="Item.FechaApertura" type="date" class="form-control" /></div>
                    </div>
                    <div class="form-check"><input asp-for="Item.Activa" type="checkbox" class="form-check-input" /><label class="form-check-label" for="Item_Activa">Activa</label></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-oro">Guardar</button>
                </div>
            </form>
        </div>
    </div>
}
