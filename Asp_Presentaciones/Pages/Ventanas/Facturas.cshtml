@page
@model Asp_Presentaciones.Pages.Ventanas.FacturasModel
@{
    ViewData["Title"] = "Facturas"; bool admin = Model.EsAdministrador;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Facturas</h1>
        <p class="text-tenue mb-0">Se generan automáticamente al registrar un pago</p>
    </div>
   
    <a asp-page="/Ventanas/Pagos" class="btn btn-oro"> Ir a los pagos</a>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success py-2">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMsg))
{
    <div class="alert alert-danger  py-2">@Model.ErrorMsg</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    @if (admin)
    {
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
    }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card">
            <div class="bb-card-body p-0">
                <table class="bb-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Código</th>
                            <th>Pago</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Subtotal</th>
                            <th>IVA (19%)</th>
                            <th>Total</th>
                            @if (admin)
                            {
                                <th class="acciones">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Lista.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-tenue text-center py-4">
                                    Sin facturas. La factura aparecera cuando hagas un pago.
                                </td>
                            </tr>
                        }
                        @foreach (var f in Model.Lista)
                        {
                            <tr>
                                <td>@f.IdFactura</td>
                                <td><strong>@f.CodigoFactura</strong></td>
                                <td><small>@Model.NombrePago(f.IdPago)</small></td>
                                <td>@Model.NombreCliente(f.IdCliente)</td>
                                <td><small>@f.FechaEmision.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td>$@f.Subtotal.ToString("N0")</td>
                                <td>$@f.Impuestos.ToString("N0")</td>
                                <td><strong style="color:var(--bb-oro-claro)">$@f.Total.ToString("N0")</strong></td>
                                @if (admin)
                                {
                                    <td class="acciones">
                                        <form method="post" asp-page-handler="Eliminar" class="d-inline"
                                              onsubmit="return bbConfirmarBorrado(event)">
                                            <input type="hidden" name="Item.IdFactura" value="@f.IdFactura" />
                                            <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">
            <div class="bb-card">
                <div class="bb-card-body p-0">
                    <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Factura"))" />
                </div>
            </div>
        </div>
    }
</div>