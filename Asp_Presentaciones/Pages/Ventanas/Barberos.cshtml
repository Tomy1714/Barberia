@page
@model Asp_Presentaciones.Pages.Ventanas.BarberosModel
@{ ViewData["Title"] = "Barberos"; bool admin = Model.EsAdministrador; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Barberos</h1>
        <p class="text-tenue mb-0">Hereda de Empleados</p>
    </div>
    @if (admin) { <button class="btn btn-oro" onclick="bbAbrirModal('modalBarbero', null)">+ Agregar barbero</button> }
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    @if (admin) { <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li> }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th><th>Empleado</th><th>Especialidad</th><th>Comisión</th><th>Serv./mes</th><th>Estado</th>@if (admin) { <th class="acciones">Acciones</th> }</tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="7" class="text-tenue text-center py-4">Sin barberos.</td></tr> }
                    @foreach (var b in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { b.IdBarbero, b.IdEmpleado, b.Especialidad, b.PorcentajeComision, b.ServiciosMes, b.ValorPromServicio, b.Activo });
                        <tr>
                            <td>@b.IdBarbero</td>
                            <td>@Model.Empleado(b.IdEmpleado)</td>
                            <td>@b.Especialidad</td>
                            <td>@b.PorcentajeComision%</td>
                            <td>@b.ServiciosMes</td>
                            <td><span class="estado @(b.Activo ? "activo" : "inactivo")">@(b.Activo ? "Activo" : "Inactivo")</span></td>
                            @if (admin)
                            {
                                <td class="acciones">
                                    <button class="btn btn-sm btn-fantasma" data-json="@json" onclick="bbAbrirModal('modalBarbero', JSON.parse(this.dataset.json))">Editar</button>
                                    <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                        <input type="hidden" name="Item.IdBarbero" value="@b.IdBarbero" />
                                        <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">
            <div class="bb-card"><div class="bb-card-body p-0">
                <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Barbero"))" />
            </div></div>
        </div>
    }
</div>

@if (admin)
{
    <div class="modal fade" id="modalBarbero" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Guardar" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> barbero</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Item.IdBarbero" />
                    <div class="mb-3">
                        <label class="form-label">Empleado</label>
                        <select asp-for="Item.IdEmpleado" class="form-select" required>
                            <option value="">— Seleccione —</option>
                            @foreach (var e in Model.Empleados)
                            {
                                <option value="@e.IdEmpleado">@e.Cargo (#@e.IdEmpleado)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3"><label class="form-label">Especialidad</label><input asp-for="Item.Especialidad" class="form-control" /></div>
                    <div class="row">
                        <div class="col mb-3"><label class="form-label">% Comisión</label><input asp-for="Item.PorcentajeComision" type="number" step="0.01" min="0" class="form-control" /></div>
                        <div class="col mb-3"><label class="form-label">Servicios/mes</label><input asp-for="Item.ServiciosMes" type="number" min="0" class="form-control" /></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Valor prom. servicio</label><input asp-for="Item.ValorPromServicio" type="number" step="0.01" min="0" class="form-control" /></div>
                    <div class="form-check"><input asp-for="Item.Activo" type="checkbox" class="form-check-input" /><label class="form-check-label" for="Item_Activo">Activo</label></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-oro">Guardar</button>
                </div>
            </form>
        </div>
    </div>
}
