@page
@model Asp_Presentaciones.Pages.Ventanas.NotificacionesModel
@{
    ViewData["Title"] = "Notificaciones";
    bool admin = Model.EsAdministrador;
    bool recep = Model.EsRecepcionista;
}

<div class="d-flex align-items-center justify-content-between mb-3">

    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">
            Notificaciones
        </h1>

        <p class="text-tenue mb-0">
            Algunos Avisos por si las moscas
        </p>
    </div>

    @if (admin || recep)
    {
        <button class="btn btn-oro"
                onclick="bbAbrirModal('modalNotificaciones', null)">
            + Nueva notificación
        </button>
    }

</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success py-2">
        @Model.Mensaje
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMsg))
{
    <div class="alert alert-danger py-2">
        @Model.ErrorMsg
    </div>
}

<ul class="nav nav-tabs mb-3">

    <li class="nav-item">
        <a class="nav-link active"
               data-bs-toggle="tab"
               href="#tabReg">
            Registros
        </a>
    </li>

    @if (admin)
    {
        <li class="nav-item">
            <a class="nav-link"
                   data-bs-toggle="tab"
                   href="#tabAud">
                Auditoría
            </a>
        </li>
    }

</ul>

<div class="tab-content">

    <div class="tab-pane fade show active" id="tabReg">

        <div class="bb-card">
            <div class="bb-card-body p-0">

                <table class="bb-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cliente</th>
                            <th>Cita</th>
                            <th>Tipo</th>
                            <th>Mensaje</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th class="acciones">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Lista.Count == 0)
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-tenue text-center py-4">
                                    Sin notificaciones registradas.
                                </td>
                            </tr>
                        }

                        @foreach (var n in Model.Lista)
                        {
                            var json = Newtonsoft.Json.JsonConvert.SerializeObject(new
                            {
                                n.IdNotificacion,
                                n.IdCliente,
                                n.IdCita,
                                n.Tipo,
                                n.Mensaje,
                                n.Estado
                            });

                            <tr>

                                <td>@n.IdNotificacion</td>

                                <td>
                                    Cliente #@n.IdCliente
                                </td>

                                <td>
                                    Cita #@n.IdCita
                                </td>

                                <td>
                                    <span class="estado activo">
                                        @n.Tipo
                                    </span>
                                </td>

                                <td>
                                    <small>@n.Mensaje</small>
                                </td>

                                <td>
                                    <span class="estado @(n.Estado == "Enviada" ? "activo" : "inactivo")">
                                        @n.Estado
                                    </span>
                                </td>

                                <td>
                                    <small>
                                        @(n.FechaEnvio?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </small>
                                </td>

                                <td class="acciones">

                                    @if (admin || recep)
                                    {
                                        <button class="btn btn-sm btn-fantasma"
                                                data-json="@json"
                                                onclick="bbAbrirModal('modalNotificaciones', JSON.parse(this.dataset.json))">
                                            Editar
                                        </button>
                                    }

                                    @if (admin)
                                    {
                                        <form method="post"
                                              asp-page-handler="Eliminar"
                                              class="d-inline"
                                              onsubmit="return bbConfirmarBorrado(event)">

                                            <input type="hidden"
                                                   name="Item.IdNotificacion"
                                                   value="@n.IdNotificacion" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-fantasma"
                                                    style="color:var(--bb-rojo)">
                                                Borrar
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>

    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">

            <div class="bb-card">
                <div class="bb-card-body p-0">

                    <partial name="_AuditoriaTab"
                             model="@((Model.Auditoria, "Notificaciones"))" />

                </div>
            </div>

        </div>
    }

</div>

@if (admin || recep)
{
    <div class="modal fade" id="modalNotificaciones" tabindex="-1">

        <div class="modal-dialog">

            <form method="post"
                  asp-page-handler="Guardar"
                  class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        <span class="modo-titulo">Nueva</span>
                        notificación
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           asp-for="Item.IdNotificacion" />

                    <div class="mb-3">
                        <label class="form-label">Id Cliente</label>

                        <input asp-for="Item.IdCliente"
                               type="number"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Id Cita</label>

                        <input asp-for="Item.IdCita"
                               type="number"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo</label>

                        <input asp-for="Item.Tipo"
                               class="form-control"
                               placeholder="Ej: Nueva Cita"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mensaje</label>

                        <textarea asp-for="Item.Mensaje"
                                  class="form-control"
                                  rows="3"
                                      placeholder="Mensaje de la notificación">
                        </textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Estado</label>

                            <input asp-for="Item.Estado"
                                   class="form-control"
                                   placeholder="Pendiente" />
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-fantasma"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-oro">
                            Guardar
                        </button>

                    </div>

                </form>

            </div>

        </div>
    }