@page
@model Asp_Presentaciones.Pages.Ventanas.TurnosModel
@{ ViewData["Title"] = "Turnos"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Turnos</h1>
        <p class="text-tenue mb-0">Turnos de trabajo de los barberos(Todavia sin logica precisa)</p>
    </div>
    <button class="btn btn-oro" onclick="bbAbrirModal('modalTurnos', null)">+ Agregar</button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th>
                        <th>Barbero</th>
                        <th>Sede</th>
                        <th>Fecha</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Estado</th>
                        <th class='acciones'>Acciones</th></tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="8" class="text-tenue text-center py-4">Sin registros.</td></tr> }
                    @foreach (var p in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { p.IdTurno, p.IdBarbero, p.IdSede, p.FechaTurno, p.HoraInicio, p.HoraFin, p.Estado });
                        <tr>
                            <td>@p.IdTurno</td>
                            <td>@p.IdBarbero</td>
                            <td>@p.IdSede</td>
                            <td>@p.FechaTurno</td>
                            <td>@p.HoraInicio</td>
                            <td>@p.HoraFin</td>
                            <td>@p.Estado</td>
                            <td class="acciones">
                                <button class="btn btn-sm btn-fantasma" data-json="@json"
                                    onclick="bbAbrirModal('modalTurnos', JSON.parse(this.dataset.json))">Editar</button>
                                <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                    <input type="hidden" name="Item.IdTurno" value="@p.IdTurno" />
                                    <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="tab-pane fade" id="tabAud">
        <div class="bb-card"><div class="bb-card-body p-0">
            <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Turnos"))" />
        </div></div>
    </div>
</div>

<div class="modal fade" id="modalTurnos" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> turnos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Item.IdTurno" />
                <div class="mb-3">
                    <label class="form-label">IdBarbero</label>
                    <input asp-for="Item.IdBarbero" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">IdSede</label>
                    <input asp-for="Item.IdSede" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">FechaTurno</label>
                    <input asp-for="Item.FechaTurno" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">HoraInicio</label>
                    <input asp-for="Item.HoraInicio" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">HoraFin</label>
                    <input asp-for="Item.HoraFin" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Estado</label>
                    <input asp-for="Item.Estado" type="text" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>
        </form>
    </div>
</div>
