@page
@model Asp_Presentaciones.Pages.Ventanas.ServiciosCorteModel
@{ ViewData["Title"] = "Servicios de Corte"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Servicios de Corte</h1>
        <p class="text-tenue mb-0">Cortes de cabello y barba</p>
    </div>
    <button class="btn btn-oro" onclick="bbAbrirModal('modalServiciosCorte', null)">+ Agregar</button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th>
<th>ID Servicio</th>
<th>Tipo Corte</th>
<th>Barba</th>
<th>Complejidad</th>
<th>Recargo</th>
<th class='acciones'>Acciones</th></tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="7" class="text-tenue text-center py-4">Sin registros.</td></tr> }
                    @foreach (var p in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { p.IdServicioCorte, p.IdServicio, p.TipoCorte, p.IncluyeBarba, p.NivelComplejidad, p.RecargoComplejidad });
                        <tr>
                            <td>@p.IdServicioCorte</td>
<td>@p.IdServicio</td>
<td>@p.TipoCorte</td>
<td>@p.IncluyeBarba</td>
<td>@p.NivelComplejidad</td>
<td>@p.RecargoComplejidad</td>
                            <td class="acciones">
                                <button class="btn btn-sm btn-fantasma" data-json="@json"
                                    onclick="bbAbrirModal('modalServiciosCorte', JSON.parse(this.dataset.json))">Editar</button>
                                <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                    <input type="hidden" name="Item.IdServicioCorte" value="@p.IdServicioCorte" />
                                    <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="tab-pane fade" id="tabAud">
        <div class="bb-card"><div class="bb-card-body p-0">
            <partial name="_AuditoriaTab" model="@((Model.Auditoria, "ServiciosCorte"))" />
        </div></div>
    </div>
</div>

<div class="modal fade" id="modalServiciosCorte" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> servicios de corte</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Item.IdServicioCorte" />
                <div class="mb-3">
                    <label class="form-label">IdServicio</label>
                    <input asp-for="Item.IdServicio" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">TipoCorte</label>
                    <input asp-for="Item.TipoCorte" type="text" class="form-control" />
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="Item.IncluyeBarba" type="checkbox" class="form-check-input" />
                    <label class="form-check-label">IncluyeBarba</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">NivelComplejidad</label>
                    <input asp-for="Item.NivelComplejidad" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">RecargoComplejidad</label>
                    <input asp-for="Item.RecargoComplejidad" type="number" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>
        </form>
    </div>
</div>
