@page
@model Asp_Presentaciones.Pages.Ventanas.TurnosModel
@{
    ViewData["Title"] = "Turnos";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Turnos</h1>
        <p class="text-tenue mb-0">Gestión de turnos de barberos</p>
    </div>
    <button class="btn btn-oro" onclick="bbAbrirModal('modalTurnos', null)">+ Agregar</button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success py-2">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMsg))
{
    <div class="alert alert-danger py-2">@Model.ErrorMsg</div>
}

<div class="bb-card">
    <div class="bb-card-body p-0">

        <table class="bb-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Barbero</th>
                    <th>Sede</th>
                    <th>Fecha</th>
                    <th>Hora inicio</th>
                    <th>Hora fin</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Lista.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-tenue py-4">Sin registros</td>
                    </tr>
                }

                @foreach (var t in Model.Lista)
                {
                    var json = Newtonsoft.Json.JsonConvert.SerializeObject(t);

                    <tr>
                        <td>@t.IdTurno</td>
                        <td>@t.IdBarbero</td>
                        <td>@t.IdSede</td>
                        <td>@t.FechaTurno</td>
                        <td>@t.HoraInicio</td>
                        <td>@t.HoraFin</td>
                        <td>@t.Estado</td>
                        <td>
                            <button class="btn btn-sm btn-fantasma"
                                    data-json="@json"
                                    onclick="bbAbrirModal('modalTurnos', JSON.parse(this.dataset.json))">
                                Editar
                            </button>

                            <form method="post" asp-page-handler="Eliminar" class="d-inline">
                                <input type="hidden" name="Item.IdTurno" value="@t.IdTurno" />
                                <button class="btn btn-sm btn-fantasma" style="color:red">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>


<div class="modal fade" id="modalTurnos" tabindex="-1">
    <div class="modal-dialog">

        <form method="post" asp-page-handler="Guardar" class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Turno</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" asp-for="Item.IdTurno" />


                <div class="mb-3">
                    <label class="form-label">Barbero</label>
                    <select asp-for="Item.IdBarbero" class="form-control">
                        <option value="">Seleccione</option>
                        @foreach (var b in Model.Barberos)
                        {
                            <option value="@b.IdEmpleado"></option>
                        }
                    </select>
                </div>

          
                <div class="mb-3">
                    <label class="form-label">Sede</label>
                    <select asp-for="Item.IdSede" class="form-control">
                        <option value="">Seleccione</option>
                        @foreach (var s in Model.Sedes)
                        {
                            <option value="@s.IdSede">@s.Nombre</option>
                        }
                    </select>
                </div>

          
                <div class="mb-3">
                    <label class="form-label">Fecha</label>
                    <input asp-for="Item.FechaTurno" type="date" class="form-control" />
                </div>

               
                <div class="mb-3">
                    <label class="form-label">Hora inicio</label>
                    <input asp-for="Item.HoraInicio" type="time" class="form-control" />
                </div>

               
                <div class="mb-3">
                    <label class="form-label">Hora fin</label>
                    <input asp-for="Item.HoraFin" type="time" class="form-control" />
                </div>

            
                <div class="mb-3">
                    <label class="form-label">Estado</label>
                    <select asp-for="Item.Estado" class="form-control">
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>

        </form>

    </div>
</div>