@page
@model Asp_Presentaciones.Pages.Ventanas.PromocionesModel
@{
    ViewData["Title"] = "Promociones"; bool admin = Model.EsAdministrador;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Promociones</h1>
        <p class="text-tenue mb-0">Descuentos especiales por fechas y eventos</p>
    </div>
    @if (admin)
    {
        <button class="btn btn-oro" onclick="bbAbrirModal('modalPromociones', null)">+ Agregar promoción</button>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success py-2">@Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMsg))
{
    <div class="alert alert-danger  py-2">@Model.ErrorMsg</div>
}


@if (Model.DescuentoCalculado.HasValue)
{
    <div class="alert alert-info py-2">
        <strong>@Model.InfoPromocion</strong><br />
        Descuento: <strong style="color:var(--bb-oro-claro)">-$@Model.DescuentoCalculado.Value.ToString("N0")</strong>
        &nbsp;·&nbsp;
        Precio final: <strong>$@Model.PrecioFinalCalculado!.Value.ToString("N0")</strong>
    </div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    @if (admin)
    {
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
    }
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card">
            <div class="bb-card-body p-0">
                <table class="bb-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Servicio</th>
                            <th>Descuento</th>
                            <th>Vigencia</th>
                            <th>Estado</th>
                            <th class="acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Lista.Count == 0)
                        {
                            <tr><td colspan="7" class="text-tenue text-center py-4">Sin promociones registradas.</td></tr>
                        }
                        @foreach (var p in Model.Lista)
                        {
                            bool vigente = Model.EstaVigente(p);
                            var json = Newtonsoft.Json.JsonConvert.SerializeObject(new
                            {
                                p.IdPromocion,
                                p.IdServicio,
                                p.Nombre,
                                p.Descripcion,
                                p.PorcentajeDescuento,
                                p.Activa,
                                FechaInicio = p.FechaInicio.ToString("yyyy-MM-dd"),
                                FechaFin = p.FechaFin.ToString("yyyy-MM-dd")
                            });
                            <tr>
                                <td>@p.IdPromocion</td>
                                <td>
                                    <strong>@p.Nombre</strong>
                                    @if (!string.IsNullOrEmpty(p.Descripcion))
                                    {
                                        <br />
                                
                                        <small class="text-tenue">@p.Descripcion</small>
                                    }
                                </td>
                                <td>@Model.NombreServicio(p.IdServicio)</td>
                                <td><span class="estado activo">@p.PorcentajeDescuento%</span></td>
                                <td>
                                    <small>
                                        @p.FechaInicio.ToString("dd/MM/yyyy")
                                        → @p.FechaFin.ToString("dd/MM/yyyy")
                                    </small>
                                </td>
                                <td>
                                    <span class="estado @(vigente ? "activo" : "inactivo")">
                                        @(vigente ? " Vigente" : " Inactiva")
                                    </span>
                                </td>
                                <td class="acciones">
                              
                                    <form method="post" asp-page-handler="CalcularDescuento" class="d-inline">

                                        <input type="hidden"
                                               name="Item.IdPromocion"
                                               value="@p.IdPromocion" />

                                        <button type="submit"
                                                class="btn btn-sm btn-fantasma"
                                                style="color:var(--bb-oro-claro)">
                                            Calcular
                                        </button>

                                    </form>
                                    @if (admin)
                                    {
                                        <button class="btn btn-sm btn-fantasma" data-json="@json"
                                                onclick="bbAbrirModal('modalPromociones', JSON.parse(this.dataset.json))">
                                            Editar
                                        </button>
                                        <form method="post" asp-page-handler="Eliminar" class="d-inline"
                                              onsubmit="return bbConfirmarBorrado(event)">
                                            <input type="hidden" name="Item.IdPromocion" value="@p.IdPromocion" />
                                            <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                        </form>
                                    }



                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @if (admin)
    {
        <div class="tab-pane fade" id="tabAud">
            <div class="bb-card">
                <div class="bb-card-body p-0">
                    <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Promocion"))" />
                </div>
            </div>
        </div>
    }
</div>

@if (admin)
{
    <div class="modal fade" id="modalPromociones" tabindex="-1">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Guardar" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span class="modo-titulo">Nueva</span> promoción</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Item.IdPromocion" />

                  
                    <div class="mb-3">
                        <label class="form-label">Nombre de la promoción</label>
                        <input asp-for="Item.Nombre" class="form-control" list="listFechasEspeciales"
                               placeholder="Ej: Día del Padre, Navidad..." required />
                        <datalist id="listFechasEspeciales">
                            @foreach (var fe in PromocionesModel.FechasEspeciales)
                            {
                                <option value="@fe.Key">@fe.Value</option>
                            }
                        </datalist>
                        <small class="text-tenue">Puedes ingresar una fecha personalizada.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <input asp-for="Item.Descripcion" class="form-control"
                               placeholder="Ej: Descuento especial por el día del padre" />
                    </div>

                 
                    <div class="mb-3">
                        <label class="form-label">Servicio al que aplica</label>
                        <select asp-for="Item.IdServicio" class="form-select" required>
                            <option value="">— Seleccione un servicio —</option>
                            @foreach (var s in Model.Servicios)
                            {
                                <option value="@s.IdServicio">
                                    @s.Nombre — $@s.PrecioBase.ToString("N0")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Porcentaje de descuento
                            <small class="text-tenue">(1% al 100%)</small>
                        </label>
                        <div class="input-group">
                            <input asp-for="Item.PorcentajeDescuento" type="number"
                                   min="1" max="100" step="0.5" class="form-control" required />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col mb-3">
                            <label class="form-label">Fecha inicio</label>
                            <input asp-for="Item.FechaInicio" type="date" class="form-control" required />
                        </div>
                        <div class="col mb-3">
                            <label class="form-label">Fecha fin</label>
                            <input asp-for="Item.FechaFin" type="date" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-check">
                        <input asp-for="Item.Activa" type="checkbox" class="form-check-input" />
                        <label class="form-check-label">Promoción activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-oro">Guardar promoción</button>
                </div>
            </form>
        </div>
    </div>
}
