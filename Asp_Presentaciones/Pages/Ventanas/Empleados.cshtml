@page
@model Asp_Presentaciones.Pages.Ventanas.EmpleadosModel
@{ ViewData["Title"] = "Empleados"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Empleados</h1>
        <p class="text-tenue mb-0">Hereda de Personas · de Empleados heredan Barberos, Recepcionistas y Administradores</p>
    </div>
    <button class="btn btn-oro" onclick="bbAbrirModal('modalEmpleado', null)">+ Agregar empleado</button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th><th>Persona</th><th>Cargo</th><th>Salario base</th><th>Ingreso</th><th>Estado</th><th class="acciones">Acciones</th></tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="7" class="text-tenue text-center py-4">Sin empleados.</td></tr> }
                    @foreach (var e in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { e.IdEmpleado, e.IdPersona, e.Cargo, e.SalarioBase, e.Activo, FechaIngreso = e.FechaIngreso.ToString("yyyy-MM-dd") });
                        <tr>
                            <td>@e.IdEmpleado</td>
                            <td>@Model.NombrePersona(e.IdPersona) <span class="text-tenue">#@e.IdPersona</span></td>
                            <td>@e.Cargo</td>
                            <td>$@e.SalarioBase.ToString("N0")</td>
                            <td>@e.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td><span class="estado @(e.Activo ? "activo" : "inactivo")">@(e.Activo ? "Activo" : "Inactivo")</span></td>
                            <td class="acciones">
                                <button class="btn btn-sm btn-fantasma" data-json="@json" onclick="bbAbrirModal('modalEmpleado', JSON.parse(this.dataset.json))">Editar</button>
                                <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                    <input type="hidden" name="Item.IdEmpleado" value="@e.IdEmpleado" />
                                    <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="tab-pane fade" id="tabAud">
        <div class="bb-card"><div class="bb-card-body p-0">
            <partial name="_AuditoriaTab" model="@((Model.Auditoria, "Empleado"))" />
        </div></div>
    </div>
</div>

<div class="modal fade" id="modalEmpleado" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> empleado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Item.IdEmpleado" />
                <div class="mb-3">
                    <label class="form-label">Persona</label>
                    <select asp-for="Item.IdPersona" class="form-select" required>
                        <option value="">— Seleccione —</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.IdPersona">@p.Nombres @p.Apellidos (#@p.IdPersona)</option>
                        }
                    </select>
                </div>
                <div class="mb-3"><label class="form-label">Cargo</label><input asp-for="Item.Cargo" class="form-control" required /></div>
                <div class="row">
                    <div class="col mb-3"><label class="form-label">Salario base</label><input asp-for="Item.SalarioBase" type="number" step="0.01" min="0" class="form-control" required /></div>
                    <div class="col mb-3"><label class="form-label">Fecha ingreso</label><input asp-for="Item.FechaIngreso" type="date" class="form-control" /></div>
                </div>
                <div class="form-check"><input asp-for="Item.Activo" type="checkbox" class="form-check-input" /><label class="form-check-label" for="Item_Activo">Activo</label></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>
        </form>
    </div>
</div>
