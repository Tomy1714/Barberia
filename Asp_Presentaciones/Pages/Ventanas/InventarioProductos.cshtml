@page
@model Asp_Presentaciones.Pages.Ventanas.InventarioProductosModel
@{ ViewData["Title"] = "Inventario Productos"; }

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 style="color:var(--bb-oro-claro);margin:0">Inventario Productos</h1>
        <p class="text-tenue mb-0">inventario de los Productos</p>
    </div>
    <button class="btn btn-oro" onclick="bbAbrirModal('modalInventarioProductos', null)">+ Agregar</button>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje)) { <div class="alert alert-success py-2">@Model.Mensaje</div> }
@if (!string.IsNullOrEmpty(Model.ErrorMsg)) { <div class="alert alert-danger py-2">@Model.ErrorMsg</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabReg">Registros</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabAud">Auditoría</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabReg">
        <div class="bb-card"><div class="bb-card-body p-0">
            <table class="bb-table">
                <thead><tr><th>#</th>
<th>Inventario</th>
<th>Producto</th>
<th>Cantidad</th>
<th class='acciones'>Acciones</th></tr></thead>
                <tbody>
                    @if (Model.Lista.Count == 0) { <tr><td colspan="5" class="text-tenue text-center py-4">Sin registros.</td></tr> }
                    @foreach (var p in Model.Lista)
                    {
                        var json = Newtonsoft.Json.JsonConvert.SerializeObject(new { p.IdInventarioProducto, p.IdInventario, p.IdProducto, p.Cantidad });
                        <tr>
                            <td>@p.IdInventarioProducto</td>
<td>@p.IdInventario</td>
<td>@p.IdProducto</td>
<td>@p.Cantidad</td>
                            <td class="acciones">
                                <button class="btn btn-sm btn-fantasma" data-json="@json"
                                    onclick="bbAbrirModal('modalInventarioProductos', JSON.parse(this.dataset.json))">Editar</button>
                                <form method="post" asp-page-handler="Eliminar" class="d-inline" onsubmit="return bbConfirmarBorrado(event)">
                                    <input type="hidden" name="Item.IdInventarioProducto" value="@p.IdInventarioProducto" />
                                    <button type="submit" class="btn btn-sm btn-fantasma" style="color:var(--bb-rojo)">Borrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="tab-pane fade" id="tabAud">
        <div class="bb-card"><div class="bb-card-body p-0">
            <partial name="_AuditoriaTab" model="@((Model.Auditoria, "InventarioProductos"))" />
        </div></div>
    </div>
</div>

<div class="modal fade" id="modalInventarioProductos" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="Guardar" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="modo-titulo">Nuevo</span> inventario productos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" asp-for="Item.IdInventarioProducto" />
                <div class="mb-3">
                    <label class="form-label">IdInventario</label>
                    <input asp-for="Item.IdInventario" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">IdProducto</label>
                    <input asp-for="Item.IdProducto" type="number" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Cantidad</label>
                    <input asp-for="Item.Cantidad" type="number" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-fantasma" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-oro">Guardar</button>
            </div>
        </form>
    </div>
</div>
